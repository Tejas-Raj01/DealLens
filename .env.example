# DealLens Environment Variables Configuration Example
# Copy this file to .env or add these key-value pairs in your deployment platform (e.g. Render Environment Settings)

# Application Settings
ENV=production
DEBUG=false

# Database Settings (Replace with your PostgreSQL instance URL / credentials)
POSTGRES_SERVER=localhost
POSTGRES_USER=deallens
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=deallens_db
POSTGRES_PORT=5432

# Redis Settings (Used for Celery async background tasks)
REDIS_HOST=localhost
REDIS_PORT=6379

# Object Storage Settings (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=deallens-documents
MINIO_SECURE=false

# AI & Embedding API Credentials
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
